<span class="cm"># Padrões comuns em URLs maliciosas</span>
ALERTAS = [<span class="str">"login"</span>, <span class="str">"verify"</span>, <span class="str">"secure"</span>, <span class="str">"-account"</span>]

<span class="kw">def</span> <span class="fn">verificar_url</span>(url):
  pontos = <span class="num">0</span>
  <span class="kw">if not</span> url.startswith(<span class="str">"https"</span>):
    pontos += <span class="num">2</span>  <span class="cm"># sem SSL</span>
  <span class="kw">for</span> p <span class="kw">in</span> ALERTAS:
    <span class="kw">if</span> p <span class="kw">in</span> url.lower():
      pontos += <span class="num">1</span>
  <span class="kw">return</span> <span class="str">"⚠️ SUSPEITA"</span> <span class="kw">if</span> pontos > <span class="num">2</span> <span class="kw">else</span> <span class="str">"✅ OK"</span></div>
      </div>

      <div class="tool-card reveal">
