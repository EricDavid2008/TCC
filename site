        <div class="tool-desc">Extrai metadados do cabeçalho de e-mails para identificar origem real, rota e sinais de spoofing.</div>
        <div class="tool-code"><span class="kw">import</span> email, re

<span class="kw">def</span> <span class="fn">analisar_header</span>(raw_email):
  msg = email.<span class="fn">message_from_string</span>(raw_email)
  origem = msg[<span class="str">"From"</span>]
  reply  = msg[<span class="str">"Reply-To"</span>]

  <span class="cm"># Sinal de spoofing: Reply-To diferente</span>
  <span class="kw">if</span> reply <span class="kw">and</span> reply != origem:
    <span class="fn">print</span>(<span class="str">"⚠️ Possível spoofing!"</span>)
    <span class="fn">print</span>(<span class="str">f"De: {origem}"</span>)
    <span class="fn">print</span>(<span class="str">f"Resposta vai para: {reply}"</span>)
  <span class="kw">return</span> msg[<span class="str">"Received"</span>]  <span class="cm"># rota do e-mail</span></div>
      </div>

