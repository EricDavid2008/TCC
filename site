<script>
// ===== COUNTER ANIMATION =====
function animateCounter(el, target, suffix, duration) {
  let start = 0;
  const step = target / (duration / 16);
  const timer = setInterval(() => {
    start += step;
    if (start >= target) { start = target; clearInterval(timer); }
    el.textContent = Math.round(start) + suffix;
  }, 16);
}

window.addEventListener('load', () => {
  animateCounter(document.getElementById('cnt1'), 375, '', 1800);
  animateCounter(document.getElementById('cnt2'), 12.5, 'B', 2200);
  animateCounter(document.getElementById('cnt3'), 95, '%', 2000);
});

// ===== SCROLL REVEAL =====
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

// ===== CRIMES DATA =====
const crimes = {
  phishing: {
    name: 'Phishing',
    risk: 'Alta', riskClass: 'risk-alta',
    desc: 'O phishing é a técnica mais comum de golpe digital. O atacante cria páginas falsas idênticas a serviços legítimos (banco, redes sociais) para capturar login e senha da vítima.',
    forense: 'Na investigação forense, peritos analisam cabeçalhos de e-mail, registros DNS, endereços IP de origem e logs de acesso ao servidor para rastrear o atacante.',
    code: `# Sinais de phishing detectados por script
def detectar_phishing(url, remetente):
    alertas = []
    
    # 1. URL não usa HTTPS
    if not url.startswith("https://"):
        alertas.append("URL sem certificado SSL")
    
    # 2. Domínio disfarçado (ex: paypa1.com)
    dominios_falsos = ["paypa1", "g00gle", "bancobrasii"]
    for d in dominios_falsos:
        if d in url:
            alertas.append(f"Domínio suspeito: {d}")
    
    # 3. Reply-To diferente do remetente
    if remetente != resposta_para:
        alertas.append("Spoofing de e-mail detectado")
    
    return alertas`
  },
  ransomware: {
    name: 'Ransomware',
    risk: 'Alta', riskClass: 'risk-alta',
    desc: 'Malware que criptografa os arquivos da vítima e exige pagamento (geralmente em criptomoeda) para liberar o acesso. Empresas e hospitais são alvos frequentes.',
    forense: 'Peritos investigam vetores de entrada (e-mail, porta RDP aberta), analisam o binário do malware em sandbox, identificam a família do ransomware e tentam recuperar chaves de descriptografia.',
    code: `# Detecção de comportamento de ransomware
import os, hashlib

def monitorar_alteracoes(pasta, baseline):
    suspeitos = 0
    for nome in os.listdir(pasta):
        path = os.path.join(pasta, nome)
        hash_atual = calcular_hash(path)
        
        # Arquivo foi modificado
        if nome in baseline:
            if hash_atual != baseline[nome]:
                suspeitos += 1
        
        # Extensão estranha adicionada (.locked, .enc)
        if nome.endswith((".locked", ".enc", ".crypt")):
            print(f"ALERTA: {nome} criptografado!")
            suspeitos += 1
    
    return suspeitos  # > 10 em pouco tempo = ransomware ativo`
  },
  injection: {
    name: 'SQL Injection',
    risk: 'Alta', riskClass: 'risk-alta',
    desc: 'Ataque que explora campos de entrada de uma aplicação web para injetar comandos SQL maliciosos, podendo expor, alterar ou deletar dados de um banco.',
    forense: 'Logs do banco de dados e do servidor web são analisados. Peritos procuram queries anômalas, acessos em horários incomuns e tentativas de UNION SELECT para extração de dados.',
    code: `# VULNERÁVEL — nunca faça assim:
query = f"SELECT * FROM users WHERE user='{entrada}'"
# Se entrada = "admin' OR '1'='1" → acesso total!

# CORRETO — use parâmetros preparados:
import sqlite3
conn = sqlite3.connect("banco.db")
cursor = conn.cursor()

# O ? separa dados do código SQL
cursor.execute(
    "SELECT * FROM users WHERE user = ? AND senha = ?",
    (usuario, senha)  # dados nunca são executados como código
)

resultado = cursor.fetchone()
# Proteção simples que evita 100% de SQL Injection`
  },
  mitm: {
    name: 'Man-in-the-Middle',
    risk: 'Media', riskClass: 'risk-media',
    desc: 'O atacante se posiciona entre a vítima e o servidor, interceptando e possivelmente alterando todas as comunicações. Comum em redes Wi-Fi públicas.',
    forense: 'Análise de tráfego de rede com Wireshark, verificação de certificados SSL anômalos, logs de ARP poisoning e comparação de rotas de pacotes são as principais técnicas.',
    code: `# Como verificar se sua conexão é segura
import ssl, socket

def verificar_certificado(host, porta=443):
    ctx = ssl.create_default_context()
    
    with ctx.wrap_socket(
        socket.socket(), server_hostname=host
    ) as s:
        s.connect((host, porta))
        cert = s.getpeercert()
    
    print(f"Emitido para: {cert['subject']}")
    print(f"Válido até: {cert['notAfter']}")
    print(f"Emissor: {cert['issuer']}")
    
    # Certificado autoassinado = sinal de MitM!
    return cert

verificar_certificado("meusite.com")`
  }
};

// ===== CRIMES INTERACTION =====
let crimeAtivo = null;
document.querySelectorAll('.crime-card').forEach(card => {
  card.addEventListener('click', () => {
    const key = card.dataset.crime;
    const detail = document.getElementById('crime-detail');
    const allCards = document.querySelectorAll('.crime-card');

    if (crimeAtivo === key) {
      detail.classList.remove('visible');
      card.classList.remove('active');
      crimeAtivo = null;
      return;
    }

    allCards.forEach(c => c.classList.remove('active'));
    card.classList.add('active');
    crimeAtivo = key;

