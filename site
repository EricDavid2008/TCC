            <div class="tool-name">Gerador de senhas seguras</div>
            <div class="tool-lang">Python 3 · secrets · string</div>
          </div>
        </div>
        <div class="tool-desc">Gera senhas criptograficamente seguras usando o módulo `secrets`, muito mais seguro que `random`.</div>
        <div class="tool-code"><span class="kw">import</span> secrets, string

<span class="kw">def</span> <span class="fn">gerar_senha</span>(tamanho=<span class="num">20</span>):
  chars = (
    string.ascii_letters +
    string.digits +
    <span class="str">"!@#$%^&*()"</span>
  )
  <span class="cm"># secrets é seguro para criptografia</span>
  <span class="kw">return</span> <span class="str">""</span>.join(
    secrets.<span class="fn">choice</span>(chars)
    <span class="kw">for</span> _ <span class="kw">in</span> range(tamanho)
  )

senha = <span class="fn">gerar_senha</span>()
<span class="fn">print</span>(senha)  <span class="cm"># ex: xK#9mP!vQz@2nRt...</span></div>
      </div>

      <div class="tool-card reveal">
        <div class="tool-header">
          <div class="tool-icon">📁</div>
          <div>
            <div class="tool-name">Monitor de integridade de arquivos</div>
            <div class="tool-lang">Python 3 · hashlib · os</div>
          </div>
        </div>
        <div class="tool-desc">Técnica usada por peritos forenses — detecta alterações não autorizadas em arquivos importantes.</div>
        <div class="tool-code"><span class="kw">import</span> hashlib, os, json

<span class="kw">def</span> <span class="fn">hash_arquivo</span>(path):
  h = hashlib.<span class="fn">sha256</span>()
  <span class="kw">with</span> <span class="fn">open</span>(path, <span class="str">"rb"</span>) <span class="kw">as</span> f:
    h.<span class="fn">update</span>(f.<span class="fn">read</span>())
  <span class="kw">return</span> h.<span class="fn">hexdigest</span>()

<span class="kw">def</span> <span class="fn">criar_baseline</span>(pasta):
  hashes = {}
  <span class="kw">for</span> nome <span class="kw">in</span> os.<span class="fn">listdir</span>(pasta):
    path = os.path.<span class="fn">join</span>(pasta, nome)
    hashes[nome] = <span class="fn">hash_arquivo</span>(path)
  <span class="kw">return</span> hashes <span class="cm"># salvar e comparar depois</span></div>
      </div>

