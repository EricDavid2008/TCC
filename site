}


// ===== PASSWORD =====
function checkPassword() {
  const pwd = document.getElementById('pwd-input').value;
  const bar = document.getElementById('pwd-bar');
  const label = document.getElementById('pwd-label');
  const tips = document.getElementById('pwd-tips');

  const checks = [
    { id: 'len', label: '≥ 12 chars', ok: pwd.length >= 12 },
    { id: 'upper', label: 'Maiúscula', ok: /[A-Z]/.test(pwd) },
    { id: 'lower', label: 'Minúscula', ok: /[a-z]/.test(pwd) },
    { id: 'num', label: 'Número', ok: /[0-9]/.test(pwd) },
    { id: 'sym', label: 'Símbolo', ok: /[^A-Za-z0-9]/.test(pwd) },
    { id: 'nocommon', label: 'Não óbvia', ok: !['123456','password','senha','qwerty'].includes(pwd.toLowerCase()) }
  ];

  const score = checks.filter(c => c.ok).length;
  const pct = Math.round((score / checks.length) * 100);

  bar.style.width = pct + '%';
  bar.style.background = pct < 34 ? '#FF5252' : pct < 67 ? '#FFD740' : '#00E5B4';
  label.textContent = pct < 34 ? '🔴 Fraca — vulnerável a ataques de força bruta' :
                       pct < 67 ? '🟡 Média — pode ser melhorada' :
                       pct < 100 ? '🟢 Boa — segura para uso geral' : '✅ Excelente — altamente segura';

  tips.innerHTML = checks.map(c =>
    `<span class="tip-pill ${c.ok ? 'tip-ok' : 'tip-bad'}">${c.ok ? '✓' : '○'} ${c.label}</span>`
  ).join('');
}


// ===== STEPS =====
const steps = [
  { icon: '🔑', title: 'Use um gerenciador de senhas', desc: 'Nunca reutilize senhas. Ferramentas como Bitwarden (gratuito e open source) geram e armazenam senhas únicas para cada serviço.' },
  { icon: '📱', title: 'Ative autenticação em dois fatores (2FA)', desc: 'Mesmo que sua senha vaze, o atacante ainda precisa do seu celular. Prefira apps autenticadores (Google Authenticator, Authy) em vez de SMS.' },
